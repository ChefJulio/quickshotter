{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickShotter",
  "version": "1.1.6",
  "identifier": "com.quickshotter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/qs_annotation.*"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBEMTI2NEVGOUZENEE4M0YKUldRL3FOU2Y3MlFTRFVORDJ5WFdLTnQxVjJQNUF2UmQ0bzVsV3JDOTdJU2wxRitFbUpyTENhZVgK",
      "endpoints": [
        "https://github.com/ChefJulio/quickshotter/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": "v1Compatible",
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/installer.nsi"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
